{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "YohakuCompanion",
    "version": "1.7.3",
    "identifier": "dev.innei.YohakuCompanion",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Yohaku Companion",
                "width": 960,
                "height": 640,
                "minWidth": 760,
                "minHeight": 520,
                "visible": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.ico", "icons/icon.png"]
    }
}
