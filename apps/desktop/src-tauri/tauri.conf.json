{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "YohakuCompanion",
    "version": "1.0.0",
    "identifier": "dev.innei.YohakuCompanion",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Yohaku Companion",
                "width": 960,
                "height": 640,
                "minWidth": 760,
                "minHeight": 520,
                "visible": true,
                "center": true
            }
        ],
        "security": {
            "capabilities": ["main"],
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "connect-src": "ipc: http://ipc.localhost",
                "img-src": "'self' data:",
                "style-src": "'self' 'unsafe-inline'",
                "object-src": "'none'",
                "base-uri": "'none'",
                "frame-src": "'none'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:5173",
                "img-src": "'self' data:",
                "style-src": "'self' 'unsafe-inline'",
                "object-src": "'none'",
                "base-uri": "'none'",
                "frame-src": "'none'",
                "form-action": "'none'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.ico", "icons/icon.png"]
    }
}
